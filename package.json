{
  "name": "stokplus-pwa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StokPlus — PWA local-first untuk stok, penjualan, pembelian, beban, dan laba usaha frozen food.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc -b",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:pwa",
    "check:pwa": "node scripts/check-pwa.mjs",
    "release:check": "npm run check && npm run test:e2e:all",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run check:pwa"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "dexie": "^4.4.7",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "daisyui": "^5.7.50",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
